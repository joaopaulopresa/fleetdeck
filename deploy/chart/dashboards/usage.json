   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (department) (fleetdeck_model_cost_usd_total)",
     "legendFormat": "{{department}}",
     "refId": "A"
